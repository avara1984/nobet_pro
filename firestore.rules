rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // FCM token'ları: sadece giriş yapmış (anonim dahil) kullanıcılar
    match /fcm_tokens/{tokenId} {
      allow read, write: if request.auth != null;
    }

    // nobet_pro koleksiyonu (bu uygulama): sadece giriş yapmış kullanıcılar
    match /nobet_pro/{belge} {
      allow read, write: if request.auth != null;
    }

    // ny_kullanicilar koleksiyonu: sadece giriş yapmış kullanıcılar
    match /ny_kullanicilar/{belge} {
      allow read, write: if request.auth != null;
    }

    // Diğer koleksiyonlar (eski uygulama): eski uygulama giriş yapmadan
    // okuduğu için okuma açık, yazma korunuyor.
    //
    // ÖNEMLİ: Firestore kuralları birbirini tamamlar (biri izin verirse
    // erişim açılır). Genel kural yukarıdaki üç koleksiyonu da kapsarsa
    // onların "giriş şart" kuralı okumada işe yaramaz. Bu yüzden onlar
    // burada açıkça hariç tutuluyor; yeni korumalı bir koleksiyon
    // eklenirse bu listeye de eklenmeli.
    match /{kol}/{belge=**} {
      allow read: if !(kol in ['nobet_pro', 'ny_kullanicilar', 'fcm_tokens']);
      allow write: if request.auth != null
                   && !(kol in ['nobet_pro', 'ny_kullanicilar', 'fcm_tokens']);
    }
  }
}
