rules_version = '2';

// Rol bazlı kurallar. Giriş sunucuda doğrulanır (functions/cekirdek.js);
// Firestore'a erişim yalnızca sunucunun verdiği özel token'la (claim:
// nobet == true) mümkündür, anonim oturum nobet_pro'ya giremez.
//
// Geri dönüş gerekirse: git log -- firestore.rules ile bu değişiklikten önceki
// sürüme dönüp `firebase deploy --only firestore:rules` çalıştırın.
//
// nobet_pro içindeki her şey yalnızca sunucunun verdiği özel token'la
// (claim: nobet == true) erişilebilir; anonim oturum hiçbir şeye giremez.
// Token'daki rol/bordro/sadecePdf/kisitliBirim bilgileri Cloud Function'ın
// `oturumAc` işlevinde (functions/cekirdek.js) kullanıcı kaydından türetilir.

service cloud.firestore {
  match /databases/{database}/documents {

    // --- yardımcılar ---------------------------------------------------------
    // Pasife alınan / onayı geri alınan / silinen kullanıcılar Cloud Function
    // (kullaniciEngelle) tarafından nobet_gizli/engelli listesine yazılır;
    // açık oturumları (ID token <= 1 saat geçerli) bu kontrolle anında düşer.
    // Belge henüz yoksa kimse engelli sayılmaz.
    function engelli() {
      return exists(/databases/$(database)/documents/nobet_gizli/engelli)
          && request.auth.uid in get(/databases/$(database)/documents/nobet_gizli/engelli).data.get('uidler', {});
    }
    function girisli() {
      return request.auth != null && request.auth.token.nobet == true && !engelli();
    }
    function yonetici() {
      return girisli() && request.auth.token.rol == 'yonetici';
    }
    // Liste hazırlayabilen: yönetici veya editör, "sadece PDF" olmayan.
    function duzenleyici() {
      return girisli() && request.auth.token.sadecePdf != true
          && (request.auth.token.rol == 'yonetici' || request.auth.token.rol == 'editor');
    }
    function bordroYetkili() {
      return girisli() && request.auth.token.bordro == true;
    }

    // Belge kimliği sınıfları (kimlik düzeni: lib/servisler/yerel_servis.dart).
    // (bordro_* / ucretler_* belgeleri nobet_bordro koleksiyonundadır.)
    function genelBelge(b) {
      return b.matches('(kurum|personeller|duyurular|nobet|versiyonlar|duyuruokuma)_.*');
    }
    function birimli(b) {
      return b.matches('(personeller|nobet|versiyonlar)_.*');
    }

    // Kısıtlı birimli kullanıcı (ör. Temizlik Nöbet Admini) diğer birimin
    // belgelerine giremez; birim ayrımı belge kimliğindeki #guvenlik/#temizlik.
    function birimIzinli(b) {
      return request.auth.token.kisitliBirim == ''
          || !b.matches('.*#(guvenlik|temizlik).*')
          || b.matches('.*#' + request.auth.token.kisitliBirim + '.*');
    }

    // duyuruokuma_<kurum>_<uid>: herkes yalnızca kendi kaydını yazar.
    function kendiOkumasi(b) {
      return b.matches('duyuruokuma_.*_' + request.auth.uid);
    }

    // --- bu uygulama ---------------------------------------------------------
    match /nobet_pro/{belge} {
      // Tek belge okuma: belge kimliğine göre.
      allow get: if girisli() && (
        (genelBelge(belge) && (
              belge.matches('duyuruokuma_.*')
                ? (yonetici() || kendiOkumasi(belge))
                : (!birimli(belge) || birimIzinli(belge))))
        // kullanicilar_*, yedekler ve bilinmeyen her şey: yalnızca yönetici
        || (!genelBelge(belge) && yonetici()));

      // Toplu sorgu (belge kimliği ÖNEKİYLE tarama): Firestore, toplu sorguda
      // belge kimliğine bakan kuralı (matches) kanıtlayamaz ve sorguyu baştan
      // reddeder; bu yüzden izin kimliğe değil yetkiye bağlanır. Uygulamadaki
      // toplu sorgular: yedek dışa aktarma ve duyuru okuma bilgisi (yönetici).
      // (Bordro listeleri nobet_bordro'dadır; orada koleksiyon düzeyinde izin
      // olduğu için bu kuralı gerektirmez.)
      allow list: if yonetici() && request.auth.token.sadecePdf != true;

      allow write: if girisli() && (
        (belge.matches('(kurum|personeller|duyurular)_.*') && yonetici()
              && (!birimli(belge) || birimIzinli(belge)))
        || (belge.matches('(nobet|versiyonlar)_.*') && duzenleyici() && birimIzinli(belge))
        || (belge.matches('duyuruokuma_.*') && kendiOkumasi(belge))
        || (!genelBelge(belge) && yonetici()));
    }

    // Bordro ve ücret belgeleri ayrı koleksiyonda: izin koleksiyon düzeyindedir,
    // bu yüzden toplu sorgular (liste, yedek) belge kimliğine bakmadan güvenle
    // yapılabilir. Bordro yetkisi olmayan (ör. Temizlik Nöbet Admini) hiçbir
    // bordro belgesini okuyamaz/listeleyemez; bordro yetkilisi ise nobet_pro'yu
    // (kullanıcılar dahil) listeleyemez.
    match /nobet_bordro/{belge} {
      allow read, write: if bordroYetkili();
    }

    // --- diğer uygulamalar ---------------------------------------------------
    match /fcm_tokens/{tokenId} {
      allow read, write: if request.auth != null;
    }

    match /ny_kullanicilar/{belge} {
      allow read, write: if request.auth != null;
    }

    // Diğer koleksiyonlar (eski uygulama): okuma açık, yazma korunuyor.
    // ÖNEMLİ: Firestore kuralları birbirini tamamlar; yukarıdaki korumalı
    // koleksiyonlar (ve sunucuya özel nobet_gizli) burada açıkça hariç
    // tutulmazsa genel "okuma açık" kuralı onları da açar. Yeni korumalı bir
    // koleksiyon eklenirse bu listeye de eklenmeli.
    match /{kol}/{belge=**} {
      allow read: if !(kol in ['nobet_pro', 'nobet_bordro', 'ny_kullanicilar', 'fcm_tokens', 'nobet_gizli']);
      allow write: if request.auth != null
                   && !(kol in ['nobet_pro', 'nobet_bordro', 'ny_kullanicilar', 'fcm_tokens', 'nobet_gizli']);
    }
  }
}
